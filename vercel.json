{
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/lembretes",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/emails",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/whatsapp.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
